{
  "name": "vuetify-dynamic-fields",
  "version": "1.0.1",
  "description": "Generates dynamic Vuetify form fields from a JSON schema for Vue 3 + Vuetify",
  "main": "src/index.js",
  "type": "module",
  "files": [
    "dist",
    "src",
    "DynamicFieldsGenerator.vue",
    "types"
  ],
  "scripts": {
    "build": "vite build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "example:install": "cd example && npm install",
    "example:dev": "cd example && npm run dev"
  },
  "types": "types/index.d.ts",
  "peerDependencies": {
    "vue": "^3.2.0",
    "vuetify": "^3.0.0",
    "@vuelidate/core": "^2.0.0",
    "@vuelidate/validators": "^2.0.0"
  },
  "devDependencies": {
    "vite": "^4.0.0",
    "@vitejs/plugin-vue": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParthJasani/vuetify-dynamic-fields.git.git"
  },
  "homepage": "https://parthjasani.github.io/vuetify-dynamic-fields",
  "bugs": {
    "url": "https://github.com/ParthJasani/vuetify-dynamic-fields/issues"
  },
  "keywords": [
    "vue",
    "vuetify",
    "form",
    "dynamic",
    "form-builder",
    "vuelidate"
  ],
  "author": "Parth Jasani",
  "license": "MIT"
}
